{
  "name": "projektmanager",
  "private": true,
  "version": "1.0.0",
  "description": "Projektsteuerung für Ingenieurbüros im Stahlwasserbau und bei beweglichen Brücken",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node --watch --disable-warning=ExperimentalWarning server/index.js\" \"vite\"",
    "build": "tsc -b && vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "seed": "node --disable-warning=ExperimentalWarning server/seed-cli.js --reset",
    "build:artifact": "tsc -b && vite build --mode artifact && node scripts/build-artifact.mjs",
    "typecheck": "tsc -b",
    "test": "node --disable-warning=ExperimentalWarning --test server/api.test.js server/api.memory.test.js"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "ldapts": "^9.1.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
}
